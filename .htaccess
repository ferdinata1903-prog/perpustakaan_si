<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses ke file .env dan file sensitif tersembunyi
    RewriteRule ^\.env$ - [F,L]
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Teruskan request ke folder public jika diakses langsung
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.env">
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
